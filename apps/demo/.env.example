# Keys for an app that allows http://localhost:5173.
SWISH_PUBLISHABLE_KEY=
SWISH_SECRET_KEY=

# The local demo server listens here. Vite forwards /api requests to this port.
PORT=5183
SWISH_API_URL=http://localhost:4100
SWISH_FRAME_URL=http://localhost:5174
SWISH_CLUSTER=devnet

# Optional: owner of the account that receives demo deposits.
# SWISH_DEMO_DESTINATION=
