# Keys for an app that allows http://localhost:5173.
SWISH_PUBLISHABLE_KEY=
SWISH_SECRET_KEY=

# The local demo server listens here. Vite forwards /api requests to this port.
PORT=5183
SWISH_API_URL=http://localhost:4190
SWISH_CLUSTER=devnet

# Optional: owner of the account that receives demo deposits.
# SWISH_DEMO_DESTINATION=

# Demo-only devnet funding. Defaults match the faucet prototype.
# DEMO_RPC_URL=https://api.devnet.solana.com
# DEMO_FUNDING_KEYPAIR_FILE=/absolute/path/to/devnet-bank.json
# On a host with no file to point at, the bank key itself (the JSON byte array). It wins over the file.
# DEMO_FUNDING_KEYPAIR=[1,2,3,…]
# DEMO_FUNDING_JOURNAL=/absolute/path/to/demo-funding.json

# For phone testing, use the public HTTPS origin of this demo.
# Its host must match the passkey RP configuration and app allowed origins.
# DEMO_PUBLIC_ORIGIN=https://demo.example.com
