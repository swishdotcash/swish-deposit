[toolchain]
anchor_version = "1.2.0"

[features]
resolution = true
skip-lint = false

[programs.localnet]
swish_deposit = "__SWISH_PROGRAM_ID__"

[programs.devnet]
swish_deposit = "__SWISH_PROGRAM_ID__"

[provider]
cluster = "localnet"
wallet = "~/.config/solana/id.json"

[scripts]
test = "cargo test -p swish-deposit"
