{
  "name": "swish-deposit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Swish Deposit: one-tap, passkey-authorised deposits into any Solana app.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "probe:foundation": "tsx scripts/probe-foundation.ts",
    "program:configure": "tsx scripts/configure-program.ts",
    "program:build": "tsx scripts/build-program.ts",
    "program:test": "tsx scripts/build-program.ts --test",
    "program:initialize": "tsx scripts/initialize.ts",
    "program:set-rp-id": "tsx scripts/set-rp-id.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "@solana-program/system": "^0.13.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.1.1",
    "@solana/subscriptions": "^0.5.0"
  }
}
