PORT=4100
# devnet | mainnet
CLUSTER=devnet
# The program deployed on this cluster. Use the same ID when you build it.
SWISH_PROGRAM_ID=
RPC_URL=https://api.devnet.solana.com
DATABASE_URL=postgres://user:password@host:5432/swish_deposit
# Pays every fee and rent. Use a file URL to a JSON keypair, or a JSON byte array or base58 secret.
SPONSOR_SECRET_KEY=
# The USDC mint deposits use on this cluster.
USDC_MINT=
# The passkey site (WebAuthn rpId). Must match the program's Config.
RP_ID=localhost
# Browser origin of the local payment frame.
FRAME_ORIGINS=http://localhost:5174
# Signs the setup transactions we hand to wallets, so only ours come back. 32+ random bytes, hex.
SERVER_SECRET=
